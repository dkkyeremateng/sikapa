# /etc/fra/env on the server — owned by root, mode 0600, passed to the container
# with --env-file. Everything here is a secret or server-specific; nothing is
# baked into the image. Lines are KEY=value with no quotes (docker --env-file
# takes the value literally, quotes included).

# --- Model -------------------------------------------------------------------
# An API key, not the /login OAuth session: an unattended server has nobody to
# sign in again if a refresh ever fails. (A copied auth.json does work — the
# refresh is locked against concurrent use — but a key has no expiry to manage.)
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Primary model for chat, the monthly review and recommendations.
OPENAI_MODEL=claude-sonnet-5
# Cheap tier for event pushes, daily commentary and extraction.
QUICK_MODEL=claude-haiku-4-5-20251001
QUICK_MODEL_PROVIDER=anthropic

# --- Your zone ----------------------------------------------------------------
# Weekly/monthly jobs and quiet hours run on this clock; the market-bound jobs
# (daily report, flex sync, event watch) are pinned to America/New_York anyway.
TZ=Africa/Nairobi
FRA_QUIET_HOURS=22:00-07:00

# --- Phone ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Inbound chat: the chats allowed to drive the agent. Required to talk to it.
TELEGRAM_ALLOWED_CHAT_IDS=
NOTIFY_CHANNELS=telegram

# --- Account data (read-only) -----------------------------------------------
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# No live IBKR gateway on the server: the MCP broker session needs an
# interactive or TOTP login and does not survive restarts.
BROKER_PROVIDERS=none

# --- SEC ------------------------------------------------------------------------
# SEC asks for a real contact in the User-Agent; the filings watcher polls it.
SEC_EDGAR_UA=Your Name you@example.com

# --- Memory -----------------------------------------------------------------------
MEMORY_BACKEND=local
FINANCIAL_RESEARCH_CHECKPOINT_DB=1

# --- Autonomy guardrails ------------------------------------------------------------
# Token caps for autonomous work (events, reports, ideas). Chat is never capped by
# these. A day's cap resets at local midnight, a month's on the 1st.
FRA_AUTONOMY_DAILY_TOKENS=400000
FRA_AUTONOMY_MONTHLY_TOKENS=6000000
# Record events and ideas without pushing them, while thresholds are tuned.
FRA_EVENTS_SHADOW=1
FRA_IDEAS_SHADOW=1

# --- Liveness ---------------------------------------------------------------------
# Pinged on every job tick; the external check alerts you when pings stop.
FRA_HEALTHCHECK_URL=
