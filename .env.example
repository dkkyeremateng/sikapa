# Copy to .env and fill in. All variables are optional in --fake mode.
#
# NOTE: model credentials do not have to live here. `/login` (or --login) stores
# them in ~/.financial-research-assistant/auth.json, written 0600, and a stored
# credential OUTRANKS the variables in this file — see the credential-store
# section near the bottom and the README's "Signing in" section.

# API key for OpenAI or any OpenAI-compatible endpoint.
# Defaults to "dummy" when OPENAI_API_BASE is set (local servers ignore it).
OPENAI_API_KEY=

# Optional: base URL of an OpenAI-compatible server for local models,
# e.g. llama.cpp (http://localhost:8080/v1), Ollama (http://localhost:11434/v1),
# LM Studio (http://localhost:1234/v1).
OPENAI_API_BASE=

# Model name. Defaults to gpt-4.1-mini (or the provider's default below). For
# local servers use the model id the server exposes, e.g. qwen2.5-7b-instruct.
OPENAI_MODEL=

# Optional: model PROVIDER. Unset/"openai" uses the OpenAI-compatible path above
# (cloud OpenAI or a local OPENAI_API_BASE server) — unchanged default. Other
# values route through LangChain's init_chat_model and read that provider's own
# key env var; install the matching extra (pip install '.[anthropic]' etc.):
#   anthropic     -> ANTHROPIC_API_KEY   (default model claude-sonnet-5)
#   google_genai  -> GOOGLE_API_KEY      (default model gemini-2.5-flash)
#   groq          -> GROQ_API_KEY        (default model llama-3.3-70b-versatile)
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Subagent dispatch (dispatch_subagent / dispatch_subagents) ---------------
# The agent can delegate work to research subagents (their own tool loop), run in
# parallel or in sequence. Subagents go through the SAME model builder as the
# primary agent, so they support OpenAI-compatible endpoints identically. By
# default they inherit ALL of the primary agent's settings (OPENAI_MODEL,
# OPENAI_API_BASE, OPENAI_API_KEY, MODEL_PROVIDER). Any SUBAGENT_* var below
# overrides just that one setting for subagents; leave it unset to inherit.
#
# Run subagents on a different (usually cheaper/faster) model — must be a model the
# active endpoint serves:
# SUBAGENT_MODEL=gpt-4.1-mini
#
# Point subagents at a SEPARATE OpenAI-compatible server (e.g. a cheap local model
# via llama.cpp / Ollama / LM Studio) while the primary agent uses the cloud:
# SUBAGENT_API_BASE=http://localhost:11434/v1
# SUBAGENT_API_KEY=                # optional; local servers usually ignore it
# SUBAGENT_MODEL_PROVIDER=openai   # or anthropic|google_genai|groq (else MODEL_PROVIDER)
#
# Per-subagent wall-clock timeout in seconds (a subagent that exceeds it comes back
# as a labeled note, not an error). Defaults to 180.
# FINANCIAL_RESEARCH_SUBAGENT_TIMEOUT=180

# --- SEC EDGAR filing intelligence (keyless) ----------------------------------
# `sec_financials` / `sec_filings` / `sec_filing_search` pull primary-source SEC
# data (as-reported 10-K XBRL financials, the filings index, and full-text search)
# for US-listed companies — no API key. SEC's firewall rejects requests whose
# User-Agent lacks a contact email; a working default is used, but SEC asks for a
# REAL contact, so set your own so heavy use is attributable to you.
# SEC_EDGAR_UA=Your Name you@domain.com
#
# `sec_filing_excerpt` / `filing_summary` rank filing passages by keyword (keyless)
# by default. Set SEC_EDGAR_SEMANTIC=1 to re-rank the keyword shortlist by embedding
# similarity (needs an embeddings endpoint — honors OPENAI_API_BASE/KEY and
# MEMORY_EMBED_MODEL); it falls back to keyword if embeddings are unavailable.
# SEC_EDGAR_SEMANTIC=1

# --- Quick / deep model tiering -----------------------------------------------
# Summarization (context compaction) is cheap work that doesn't need the primary
# reasoning model. Set QUICK_MODEL to route it to a cheaper/faster model while the
# agent itself stays on the primary; unset = the primary model does it (unchanged).
# Same override shape as SUBAGENT_* — each unset value falls back to the primary.
# QUICK_MODEL=gpt-4.1-nano
# QUICK_API_BASE=http://localhost:11434/v1
# QUICK_API_KEY=
# QUICK_MODEL_PROVIDER=openai   # or anthropic|google_genai|groq (else MODEL_PROVIDER)

# --- IBKR market-data MCP server (read-only) ----------------------------------
# The assistant loads Interactive Brokers market-data tools from an MCP server
# and filters them to READ-ONLY (balances, positions, quotes, price history,
# contract/company lookups). Order-entry and watchlist-write tools are never
# exposed. Leave BOTH unset to run with local calculators only (and --fake).
#
# Option A — remote/hosted MCP server over HTTP (streamable_http):
# IBKR_MCP_URL=https://your-ibkr-mcp-host/mcp
# IBKR_MCP_TOKEN=                 # optional; sent as "Authorization: Bearer <token>"
#
# Option B — local MCP server process over stdio:
# IBKR_MCP_COMMAND=npx
# IBKR_MCP_ARGS=-y interactive-brokers-mcp
#
# The agent NEVER calls the server's `authenticate` tool by default: on some
# servers it opens an interactive browser login and can disrupt a live session.
# Authenticate the IB gateway yourself (see README) and keep that session alive.
# Only if your server does a NON-interactive/headless session bootstrap, opt in:
# IBKR_ALLOW_AUTHENTICATE=1
#
# --- Optional: quote cache TTL (seconds) --------------------------------------
# Repeated quotes for the same symbol within this window are served from memory
# instead of re-hitting the broker. Defaults to 900 (15 min); <= 0 disables it so
# every call goes out fresh — use that when you need tick-accurate prices.
# FINANCIAL_RESEARCH_PRICE_TTL=900

# --- Pluggable brokers --------------------------------------------------------
# The live-data broker is a registry entry (see src/.../brokers.py). IBKR ships
# as the reference provider; a different broker plugs in by registering one
# BrokerProvider (env-driven config + a read-only filter) — no core-code changes.
# A broker activates automatically once its own env vars are set. When several
# are configured, pin an explicit subset (comma-separated) to mount one at a time:
# BROKER_PROVIDERS=ibkr
#
# --- IBKR headless auth (interactive-brokers-mcp) -----------------------------
# By default that server opens a BROWSER login (localhost:5001), and because it
# runs as a stdio child of the agent, a restart usually means re-authenticating.
# Headless mode re-auths automatically in the background — no browser, and with a
# TOTP secret, no manual 2FA either. These are read by the MCP server, not this
# app. SENSITIVE: your brokerage password + 2FA secret in a file — lock down .env
# and use a PAPER account first (IB_PAPER_TRADING=true). See README + the server's
# docs (https://github.com/code-rabi/interactive-brokers-mcp).
# IB_HEADLESS_MODE=true
# IB_USERNAME=your-ib-username
# IB_PASSWORD_AUTH=your-ib-password
# IB_TWO_FA_STRATEGY=totp          # automate 2FA (else headless waits ~60s for you)
# IB_TOTP_SECRET=your-totp-secret  # required for fully hands-off 2FA
# IB_PAPER_TRADING=true            # start on a paper account
# IB_FORCE_STANDALONE_GATEWAY=true # skip gateway discovery if it misbehaves

# --- Optional: additional MCP servers (beyond IBKR) ---------------------------
# Mount extra read-only MCP data servers (FRED macro data, fundamentals, SEC
# filings, etc.) alongside IBKR. JSON object of {name: server_spec} in
# MultiServerMCPClient form. IBKR is strictly allowlisted (it can trade); these
# extra servers are filtered with a write-verb denylist, so noun-named data tools
# survive while anything mutating is dropped. An "ibkr" key here is ignored.
# EXTRA_MCP_SERVERS={"fred": {"command": "npx", "args": ["-y", "fred-mcp-server"], "transport": "stdio"}}

# --- Optional: durable conversation memory (survives restarts) ----------------
# Unset = in-process MemorySaver (default; state lost on exit, --resume replays
# only the transcript). Set a path (or "default" for
# ~/.financial-research-assistant/checkpoints.db) to checkpoint conversations to
# SQLite so --resume restores the model's actual memory across restarts.
# FINANCIAL_RESEARCH_CHECKPOINT_DB=default

# --- Optional: self-critique after a research report --------------------------
# After `--research` writes a report, the agent distills process "lessons" into
# long-term memory and recalls them on the next run (needs MEMORY_BACKEND set).
# Free gap-scan lessons always run; this controls only the extra LLM critique
# call. On by default — set to 0 to skip that call.
# RESEARCH_REFLECT=0

# --- Optional: web search provider for the `web_search` news tool -------------
# Keyless by default (DuckDuckGo news, no config needed). Set a Tavily key for
# higher-quality LLM-oriented news results (https://tavily.com):
# TAVILY_API_KEY=

# --- Legacy GLOBAL overrides (prefer /login) ----------------------------------
# These predate the credential store and apply ONE value to EVERY model. /login
# records price and window per model in auth.json, which is what the status bar
# bills and gauges from — reach for these only when nothing else knows your model
# (a custom gateway, an unrecognized local model), and unset them once you do
# configure per-model values.
#
# Token pricing, USD per 1M tokens. Both must be set to take effect.
# OPENAI_INPUT_COST_PER_1M=0.40
# OPENAI_OUTPUT_COST_PER_1M=1.60
#
# Context window in tokens. NOTE: this one BEATS the per-model context_window in
# auth.json as well as the built-in table, so leaving it set silently pins every
# model to one size. `/config` prints the effective window per model and which
# source won. Not cosmetic: AGENT_AUTO_COMPACT and AGENT_CLEAR_TOOL_RESULTS are
# fractions OF it; falls back to 128000 when nothing knows the model.
# OPENAI_CONTEXT_WINDOW=32768

# --- Optional: automatic context compaction (any interface) -------------------
# Fraction of the context window at which run_turn summarizes older turns before
# the next turn (like /compact, but automatic — works headless, in evals, and in
# any service embedding run_turn). Unset = off.
#
# Against a large window (e.g. a 256k local model) 0.85 means compaction only
# fires near ~218k tokens, by which point every turn pays a punishing prefill.
# Something near 0.5 keeps turns responsive.
# AGENT_AUTO_COMPACT=0.85

# --- Optional: clearing stale tool results ------------------------------------
# The cheap tier below auto-compaction: once the thread crosses this fraction of
# the context window, tool RESULTS older than the last 3 are replaced with a
# placeholder (the tool CALL and its args stay, so the model still knows it
# looked something up). Deterministic — no model call, unlike compaction — and
# tool output is the bulkiest, most disposable thing in a long thread, so this
# often defers compaction entirely. Keep it below AGENT_AUTO_COMPACT.
# Defaults to 0.35; set to 0 to disable.
# AGENT_CLEAR_TOOL_RESULTS=0.35

# --- Optional: Anthropic prompt caching TTL (MODEL_PROVIDER=anthropic) ---------
# The ~11k-token fixed prefix (tool schemas + system prompt) is re-sent on every
# step of every turn. With the [anthropic] extra installed it's cached
# automatically: "5m" (default) writes at 1.25x and reads at ~0.1x, paying for
# itself within a single multi-step turn. "1h" writes at 2x but survives a user
# thinking between turns — worth it for slow-paced chat sessions.
# Ignored by the OpenAI-compatible path, which caches server-side on its own.
# Cache reads AND writes are metered and billed separately (the status bar shows
# "cache <read> +<write> w"), so the trade-off above is visible per turn.
# ANTHROPIC_CACHE_TTL=5m

# --- Optional: give subagents the full toolset --------------------------------
# By default a subagent gets the core research tools plus only the groups its
# task text implicates (a task matching no group falls back to everything), which
# cuts its per-step schema cost by 60-90%. Set this to restore the full toolset
# if routing ever withholds a tool a task needed.
# FINANCIAL_RESEARCH_SUBAGENT_ALL_TOOLS=1

# --- Optional: credential store (keys outside this file) ----------------------
# Keys set here end up in the process environment and are inherited by every
# subprocess. The alternative is `/login` (TUI) or `--login` (CLI), which stores
# credentials in ~/.financial-research-assistant/auth.json, written 0600.
#
# Several providers can be configured at once: credentials are keyed by provider,
# and each model tier ("default" / "quick" / "subagent") records which one it
# uses, so switching back needs no re-login. Each credential carries the endpoint,
# the models it serves, their per-1M costs, and their context windows — so a key
# is never paired with a mismatched OPENAI_API_BASE or a model from another
# vendor. The store OUTRANKS the variables in this file, so a credential set
# there is not silently shadowed by a stale OPENAI_API_KEY left here.
# FINANCIAL_RESEARCH_AUTH_FILE=~/.financial-research-assistant/auth.json
#
# A stored key may be a literal, "$VAR" (read from the environment at use time),
# or "!command" (take the secret from a command's stdout, so it can live in
# 1Password/pass and never touch disk). "!command" is execution from a config
# file, so it stays off unless you opt in here.
# FINANCIAL_RESEARCH_AUTH_ALLOW_EXEC=1

# --- Optional: OpenTelemetry tracing (pip install '.[tracing]') ---------------
# Enable with AGENT_TRACING=1, then point OTLP at your backend (Langfuse,
# LangSmith, Arize Phoenix, or any collector). See the README "Tracing" section.
# AGENT_TRACING=1
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 pk:sk>
# OTEL_SERVICE_NAME=financial-research-assistant   # service.name on the spans
# Native LangSmith alternative (LangGraph auto-instrumentation):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# --- Optional: long-term (cross-session) memory -------------------------------
# Unset = session-only (default). "local" = zero-dependency keyword store;
# "mem0" = the mem0 layer (pip install mem0ai). Scoped by MEMORY_USER. See
# references/memory-guide.md.
# MEMORY_BACKEND=local
# MEMORY_USER=default
# MEMORY_DIR=~/.agent-builder/memory
#
# Recall is keyword-based unless an embeddings endpoint is configured (it reuses
# OPENAI_API_BASE/KEY), in which case hits are ranked by cosine similarity.
# MEMORY_EMBED_MODEL=text-embedding-3-small
# MEMORY_SIM_THRESHOLD=0.25        # minimum similarity for a semantic hit
#
# A new fact that contradicts an older one supersedes it (the old value is kept,
# archived, for audit — `--memory` shows it as [superseded] but never recalls it).
# On by default; 0/false/no/off keeps every version live.
# MEMORY_SUPERSEDE=0

# --- Optional: alert rules and how they're delivered --------------------------
# `add_alert` stores standing rules the `--digest` run checks (price drop/rise,
# crossing a level, earnings soon). Rules live in
# ~/.financial-research-assistant/alerts.json — override the path here.
# FINANCIAL_RESEARCH_ALERTS_FILE=~/.financial-research-assistant/alerts.json
#
# A firing rule makes a sound and raises an OS notification, so it reaches you
# with the terminal buried. Both are ON by default; set either to 0/false/no/off
# to silence it (a shared space, or a terminal that flashes the whole screen).
# FINANCIAL_RESEARCH_ALERT_SOUND=0
# FINANCIAL_RESEARCH_ALERT_DESKTOP=0

# --- Optional: scheduled tasks and where their answers are sent ---------------
# `schedule_task` (and `--schedule`) queue work to run later — "analyse NOMD's
# results tomorrow at 9am". A runner executes what's due and pushes the answer:
#   --run-due     one pass, then exit (put this in cron/launchd, e.g. */15)
#   --watch [S]   the same pass every S seconds in the foreground (default 60)
# Tasks live in ~/.financial-research-assistant/tasks.json (0600) — override here.
# FINANCIAL_RESEARCH_TASKS_FILE=~/.financial-research-assistant/tasks.json
#
# How many tasks one tick may run (default 10). A backlog built up while the
# machine was off drains over consecutive ticks; the runner logs what it deferred.
# FINANCIAL_RESEARCH_TASK_BATCH=10
#
# How long the agent may go without seeing a runner tick before it warns that a
# newly scheduled task will never run (minutes, default 60). Raise it if your cron
# interval is longer than an hour.
# FINANCIAL_RESEARCH_RUNNER_MAX_SILENCE=60
#
# Which channels a finished task is delivered to. Unset = every configured one;
# set it to pin a subset. Registered: telegram, desktop, stdout (stdout is only
# ever used when named here). A task can also name its own channel.
# NOTIFY_CHANNELS=telegram,desktop
#
# Telegram delivery. Create a bot with @BotFather for the token, then message it
# and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# Check it end-to-end with:  financial-research-assistant --notify-test
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=987654321
#
# INBOUND (off by default): let listed chats message the bot and drive the agent.
# Every message becomes untrusted input to a tool-using agent that can read your
# imported statements and positions, so this is opt-in and there is no default —
# with this unset nothing is polled, even when the two vars above are set. List
# only chat ids you control; messages from anywhere else are dropped unread.
# The read-only broker boundary still applies: an inbound message can research
# and read the account, never trade.
# TELEGRAM_ALLOWED_CHAT_IDS=987654321
#
# Where the inbound cursor is kept, so a restart doesn't re-answer old messages.
# FINANCIAL_RESEARCH_TELEGRAM_STATE=~/.financial-research-assistant/telegram-offset.json
#
# `render_report` typesets a summary as a PNG + PDF and sends it as a file. It
# renders with headless Chrome/Chromium, auto-detected on the usual macOS and Linux
# paths — set this only if yours lives somewhere else. Without a browser the tool
# still writes the HTML and says why there is no image.
# FINANCIAL_RESEARCH_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# --- Optional: broker statement-import store ----------------------------------
# `import_ibkr_statement` parses a broker statement (trades + cash flows +
# positions) into a local SQLite database; `query_transactions` reads it back.
# The format is auto-detected: an IBKR Activity Statement CSV, or a cross-broker
# OFX/QFX file (Vanguard, E*TRADE, Schwab, most banks). OFX/QFX support needs the
# optional extra:  pip install 'financial-research-assistant[ofx]'  (ofxtools).
# Defaults to ~/.financial-research-assistant/statements.db — override here.
# FINANCIAL_RESEARCH_STATEMENTS_DB=~/.financial-research-assistant/statements.db

# --- Optional: directory CSV exports are confined to ---------------------------
# `export_data` only writes inside this directory (paths outside it are refused).
# FINANCIAL_RESEARCH_EXPORT_DIR=~/.financial-research-assistant/exports

# --- Optional: document-upload RAG store --------------------------------------
# `ingest_document` chunks a local .txt/.md/.html/.pdf into a JSONL index that
# `ask_document` searches (with citations). PDF text extraction needs the optional
# extra:  pip install 'financial-research-assistant[documents]'  (pypdf); text/
# Markdown/HTML work without it. Chunks are embedded for SEMANTIC search when an
# embeddings endpoint is configured (reuses OPENAI_API_BASE/KEY + MEMORY_EMBED_MODEL),
# else keyword search is used. Defaults to ~/.financial-research-assistant/documents.
# FINANCIAL_RESEARCH_DOCS_DIR=~/.financial-research-assistant/documents

# --- Optional: IBKR Flex Web Service (programmatic statement pull) -------------
# `--flex-sync` pulls an IBKR Activity statement via the Flex Web Service instead
# of downloading the CSV by hand. In IBKR: Reports → Flex Queries → create an
# Activity Flex Query (note its Query ID) and enable the Flex Web Service (note the
# token). The token is SENSITIVE — read only from here, never passed to the model.
# Currently the pulled XML is saved to disk (auto-import into the queryable store
# is pending a parser); the manual `import_ibkr_statement` CSV path is unaffected.
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=
# FINANCIAL_RESEARCH_FLEX_DIR=~/.financial-research-assistant/flex

# --- Optional: where the app writes things ------------------------------------
# All default under ~/.financial-research-assistant/ ; set any to relocate it.
# FINANCIAL_RESEARCH_SESSIONS_DIR=~/.financial-research-assistant/sessions   # transcripts (/sessions, --resume)
# FINANCIAL_RESEARCH_REPORTS_DIR=~/.financial-research-assistant/reports     # --research markdown reports
# FINANCIAL_RESEARCH_EVAL_DIR=~/.financial-research-assistant/eval           # eval improvement reports + candidate addenda

# --- Optional: tuning without editing code ------------------------------------
# Extra text appended to the system prompt. The inline var wins over the file;
# the file is what eval-driven self-improvement writes (see the README's
# "Eval-driven self-improvement") — deleting it reverts any learned addendum.
# FINANCIAL_RESEARCH_PROMPT_ADDENDUM=Always show figures in GBP as well.
# FINANCIAL_RESEARCH_PROMPT_ADDENDUM_FILE=~/.financial-research-assistant/prompt_addendum.txt
#
# Price/context data file, merged OVER the built-in tables by model prefix, so a
# new model or a changed price needs no code edit and no restart. Shape:
#   {"pricing": {"my-model": [1.0, 3.0]}, "context": {"my-model": 200000}}
# Per-model values from /login are more specific and are usually the better tool;
# this is for models you reach WITHOUT a stored credential.
# FINANCIAL_RESEARCH_PRICING_FILE=~/.financial-research-assistant/pricing.json

# --- Optional: base/reporting currency for FX conversion ----------------------
# The analytics tools (income_summary, allocation, convert_currency) convert
# non-base amounts to this currency using keyless Yahoo FX rates. Defaults to USD.
# BASE_CURRENCY=USD
